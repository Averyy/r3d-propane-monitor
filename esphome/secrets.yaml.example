# Copy to secrets.yaml (which git ignores) and fill in.
# ESPHome Device Builder keeps its own secrets.yaml: add these entries there.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# 32 random bytes, base64: run `openssl rand -base64 32`.
api_encryption_key: "replace-with-32-random-bytes-in-base64"

ota_password: "choose-a-password"

# The device's own hotspot if it can't join your Wi-Fi. At least 8 characters.
fallback_ap_password: "choose-another-password"
